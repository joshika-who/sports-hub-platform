# =============================================================================
# Sports Hub Platform - Environment Configuration (.env.example)
# Copy this file to .env (or backend/.env & frontend/.env.local) to customize.
# All variables have safe fallback defaults so the app starts with ZERO config!
# =============================================================================

# --- Application & Security ---
APP_NAME="Sports Hub Platform API"
APP_ENV=development
SECRET_KEY=super-secret-jwt-key-change-in-production-9f8e7d6c5b4a3210
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database & Cache (Auto-falls back to SQLite + In-Memory Dict if unreachable) ---
# Leave unset or point to local SQLite for instant zero-Docker setup:
DATABASE_URL=sqlite:///./sportshub.db
# Uncomment below when running `docker-compose up -d`:
# DATABASE_URL=postgresql+psycopg2://sportshub:sportshub_pass@localhost:5432/sportshub
REDIS_URL=redis://localhost:6379/0

# --- AI Injury Assistant (Ollama + ChromaDB RAG) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_SECONDS=25
CHROMA_PERSIST_DIR=./chroma_data

# --- Payments (mock | live) ---
PAYMENT_MODE=mock
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_placeholder
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT

# --- Push Notifications (mock | live) ---
NOTIFY_MODE=mock
FCM_PROJECT_ID=sportshub-demo
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.sportshub.app
APNS_AUTH_KEY_PATH=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

